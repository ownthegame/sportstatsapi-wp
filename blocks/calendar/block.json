{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sportstatsapi/calendar",
	"title": "Team calendar",
	"category": "widgets",
	"icon": "calendar",
	"description": "A team's matches to add to the visitor's calendar (.ics subscription).",
	"keywords": [
		"sportstatsapi",
		"sport",
		"calendar",
		"ics",
		"schedule"
	],
	"textdomain": "live-scores-league-tables",
	"attributes": {
		"competition": {
			"type": "string",
			"default": ""
		},
		"competitionName": {
			"type": "string",
			"default": ""
		},
		"team": {
			"type": "string",
			"default": ""
		},
		"teamName": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"rows": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"default": ""
		},
		"view": {
			"type": "string",
			"default": ""
		},
		"country": {
			"type": "string",
			"default": ""
		},
		"round": {
			"type": "string",
			"default": ""
		},
		"radius": {
			"type": "string",
			"default": ""
		},
		"font": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "sportstatsapi-editor"
}
